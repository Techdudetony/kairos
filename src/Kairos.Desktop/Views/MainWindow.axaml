<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kairos.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="Kairos.Desktop.Views.MainWindow"
        x:DataType="vm:CreateFocusIntentionViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kairos">

    <Design.DataContext>
        <vm:CreateFocusIntentionViewModel />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="8">

        <TextBlock Text="Kairos" FontSize="24" FontWeight="SemiBold" />

        <TextBlock Text="Task name" />
        <TextBox Text="{Binding TaskName}" />

        <TextBlock Text="Planned duration (minutes)" />
        <NumericUpDown Value="{Binding PlannedDurationMinutes}" Minimum="1" />

        <TextBlock Text="Task context (optional)" />
        <TextBox Text="{Binding TaskContext}" />

        <TextBlock Text="Expected applications (optional, comma-separated)" />
        <TextBox Text="{Binding ExpectedApplicationsInput}" />

        <Button Content="Start" Command="{Binding StartCommand}" Margin="0,8,0,0" />

        <ItemsControl ItemsSource="{Binding ValidationMessages}" />

        <TextBlock Text="{Binding ActiveSession.State}"
                    IsVisible="{Binding ActiveSession, Converter={x:Static ObjectConverters.IsNotNull}}" />

    </StackPanel>

</Window>
