<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kairos.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="180"
        x:Class="Kairos.Desktop.Views.ActiveIntentionWindow"
        x:DataType="vm:ActiveIntentionViewModel"
        Width="300"
        Height="180"
        Title="Kairos - Active Intention">

    <Design.DataContext>
        <vm:ActiveIntentionViewModel />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="8">

        <TextBlock Text="No active intention"
                   IsVisible="{Binding ActiveSession, Converter={x:Static ObjectConverters.IsNull}}" />

        <StackPanel IsVisible="{Binding ActiveSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Spacing="4">
            <TextBlock Text="{Binding ActiveSession.Intention.TaskName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveSession.State}" Opacity="0.7" />
        </StackPanel>

        <Button Content="Edit" Click="OnEditClick" Margin="0,8,0,0" />

    </StackPanel>

</Window>
