<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kairos.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="400"
        d:DesignHeight="300"
        x:Class="Kairos.Desktop.Views.EditFocusIntentionWindow"
        x:DataType="vm:EditFocusIntentionViewModel"
        Width="400"
        Height="300"
        Title="Kairos - Edit Intention">

    <Design.DataContext>
        <vm:EditFocusIntentionViewModel />
    </Design.DataContext>

    <StackPanel Margin="16" Spacing="8">

        <TextBlock Text="Task name" />
        <TextBox Text="{Binding TaskName}" />

        <TextBlock Text="Task context (optional)" />
        <TextBox Text="{Binding TaskContext}" />

        <TextBlock Text="Expected applications (optional, comma-separated)" />
        <TextBox Text="{Binding ExpectedApplicationsInput}" />

        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

        <ItemsControl ItemsSource="{Binding ValidationMessages}" />

    </StackPanel>

</Window>
